    private async Task ComparisonSettingChanged(ChangeEventArgs args, string method, Action<double> update)
    {
        if (_workbench is null || args.Value is not string input ||
            !double.TryParse(input, NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            _shaderStatus = "Could not read the comparison setting.";
            return;
        }
        try
        {
            await _workbench.InvokeVoidAsync(method, value);
            update(value);
        }
        catch (JSException exception)
        {
            _shaderStatus = $"Could not change comparison setting: {exception.Message}";
        }
    }

    private async Task RunComparison()
    {
        if (_workbench is null) { _comparisonStatus = "The workbench is not available."; return; }
        _comparisonRunning = true;
        _comparisonResults.Clear();
        _comparisonStatus = "Measuring SDF rays and matching triangles. Keep the camera and viewport unchanged.";
        try
        {
            _comparisonResults = await _workbench.InvokeAsync<List<ComparisonResult>>("runComparison");
            _comparisonStatus = $"Complete. Maps: {_shadowResolution} per light; shadows {(_softShadowsEnabled ? "on" : "off")}; main {(_directionalLightEnabled ? "on" : "off")}; overhead {(_overheadLightEnabled ? "on" : "off")}; AO {(_ambientOcclusionEnabled ? "on" : "off")}; movement {(_lightAnimationEnabled ? "on" : "off")}; flicker {(_lightFlickerEnabled ? "on" : "off")}. Settings restored.";
        }
        catch (JSException exception)
        {
            _comparisonStatus = $"Comparison failed: {exception.Message}";
        }
        finally
        {
            _comparisonRunning = false;
        }
    }

